# Port for full-stack application (default: 3000)
PORT=3000

# SQLite Database connection for Prisma
DATABASE_URL="file:../server/prisma/dev.db"

# Secret key for signing session tokens and cookies
SESSION_SECRET="auravisa-secure-session-key-change-in-production-32char"

# Frontend Origin for strict CORS validation
FRONTEND_ORIGIN="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI Visa Assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

